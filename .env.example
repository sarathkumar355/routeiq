# Copy this file to .env and fill in real values for local development.
# Nothing here is required for the app to start in Phase 1.

# --- App ---
ENVIRONMENT=development

# --- Database (optional until you run DB-dependent code/tests) ---
# Example for local Docker Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql://routeiq:routeiq@localhost:5432/routeiq
DATABASE_URL=

# --- AI provider (not used until Phase 5) ---
GEMINI_API_KEY=
